# ==============================================================================
# Nginx Configuration for {{ server.project_name }}
# Generated automatically by Nginx-CLI Setup Tool
# ==============================================================================

{% if server.ssl_enabled and server.ssl_redirect %}
# HTTP Server: Redirect all HTTP requests to HTTPS
server {
    listen {{ server.listen_port }};
    listen [::]:{{ server.listen_port }};
    server_name {{ server.server_name }};

    # Allow ACME Challenge for Let's Encrypt renewal
    location ^~ /.well-known/acme-challenge/ {
        default_type "text/plain";
        root /var/www/certbot;
        allow all;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
{% endif %}

# Main Application Server Block
server {
{% if server.ssl_enabled %}
    listen {{ server.ssl_listen_port }} ssl{% if server.enable_http2 %} http2{% endif %};
    listen [::]:{{ server.ssl_listen_port }} ssl{% if server.enable_http2 %} http2{% endif %};
{% else %}
    listen {{ server.listen_port }};
    listen [::]:{{ server.listen_port }};
{% endif %}

    server_name {{ server.server_name }};

    client_max_body_size {{ server.client_max_body_size }};

{% if server.access_log %}
    access_log {{ server.access_log }};
{% endif %}
{% if server.error_log %}
    error_log {{ server.error_log }} warn;
{% endif %}

{% if server.ssl_enabled %}
    # SSL Certificates
{% if server.ssl_cert_path %}
    ssl_certificate {{ server.ssl_cert_path }};
{% endif %}
{% if server.ssl_key_path %}
    ssl_certificate_key {{ server.ssl_key_path }};
{% endif %}

    # Modern SSL Protocols and Ciphers (Mozilla Intermediate Configuration)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    # SSL Session Optimization
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
{% endif %}

{% if server.enable_gzip %}
    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/rss+xml application/atom+xml image/svg+xml;
{% endif %}

    # Let's Encrypt ACME Challenge verification
    location ^~ /.well-known/acme-challenge/ {
        default_type "text/plain";
        root /var/www/certbot;
        allow all;
    }

{% for route in server.routes %}
    # Route: {{ route.name }} ({{ route.path }}) -> {{ route.target_url }}
    location {{ route.path }} {
        proxy_pass {{ route.target_url }};
        proxy_http_version 1.1;

        # Standard Proxy Headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

{% if route.websocket %}
        # WebSocket Support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
{% endif %}

        # Timeouts & Buffer Tuning
        proxy_connect_timeout {{ route.proxy_connect_timeout }}s;
        proxy_send_timeout {{ route.proxy_send_timeout }}s;
        proxy_read_timeout {{ route.proxy_read_timeout }}s;
        proxy_buffering on;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;

{% for header_name, header_value in route.custom_headers.items() %}
        proxy_set_header {{ header_name }} "{{ header_value }}";
{% endfor %}
    }

{% endfor %}
}
